PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/BusinessCall

# Auth
JWT_SECRET=<bcrypt_hashed_secret>
ACCESS_TOKEN_SECRET=<your_access_token_secret>

# WhatsApp Cloud API (Meta)
META_APP_ID=<your_meta_app_id>
META_APP_SECRET=<your_meta_app_secret>
META_API_VERSION=v18.0
WHATSAPP_API_VERSION=v18.0
WHATSAPP_ACCESS_TOKEN=<your_whatsapp_permanent_access_token>
WHATSAPP_PHONE_NUMBER_ID=<your_whatsapp_phone_number_id>
WHATSAPP_WABA_ID=<your_waba_id>
WHATSAPP_APP_SECRET=<your_meta_app_secret>
WHATSAPP_BUSINESS_ACCOUNT_ID=<your_business_account_id>
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<your_custom_verify_token>
WHATSAPP_ENFORCE_WEBHOOK_SIGNATURE=false
WHATSAPP_TOKEN_ENCRYPTION_KEY=<random_base64_key>
