<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="3dp">


    <TextView
        android:id="@+id/tvName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_medium"
        android:paddingHorizontal="10dp"
        android:text="Unknown"
        android:textSize="14sp" />

    <RelativeLayout
        android:id="@+id/rlRow2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tvName">

        <ImageView
            android:id="@+id/ivCallType"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:src="@drawable/ic_misscall"
            app:tint="#dbdbdb" />

        <TextView
            android:id="@+id/tvNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@id/ivCallType"
            android:fontFamily="@font/montserrat_medium"
            android:paddingStart="10dp"
            android:text="9131414139"
            android:textColor="@color/black"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/ivCopy"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="6dp"
            android:layout_centerVertical="true"
            android:layout_marginTop="2dp"
            android:tint="#A5A3A3"
            android:layout_toEndOf="@id/tvNumber"
            android:src="@drawable/ic_copy" />

        <ImageView
            android:id="@+id/ivShareContact"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="6dp"
            android:layout_centerVertical="true"
            android:layout_marginTop="2dp"
            android:tint="#A5A3A3"
            android:layout_toEndOf="@id/ivCopy"
            android:src="@drawable/ic_share" />

        <LinearLayout
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:weightSum="2"
            android:layout_marginEnd="20dp"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivCall"
                android:layout_width="33dp"
                android:layout_height="33dp"
                android:padding="0dp"
                android:layout_marginTop="0dp"
                android:layout_weight="1"
                android:src="@drawable/ic_call_quick" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="5dp"/>

            <ImageView
                android:id="@+id/ivWhatsapp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:padding="5dp"
                android:layout_weight="1"
                android:src="@drawable/ic_whatsapp" />

        </LinearLayout>

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#85DBDBDB" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingHorizontal="10dp">

        <ImageView
            android:id="@+id/ivAddContact"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:layout_weight="1"
            android:src="@drawable/ic_phonebook" />

        <ImageView
            android:id="@+id/ivNote"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:layout_weight="1"
            android:src="@drawable/ic_notes" />

        <ImageView
            android:id="@+id/ivShareContactWith"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="3dp"
            android:layout_weight="1"
            android:src="@drawable/ic_share_contacts"
            android:tint="#6C63FF" />



        <ImageView
            android:id="@+id/ivTextMsg"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:layout_weight="1"
            android:src="@drawable/ic_msg" />

        <ImageView
            android:id="@+id/ivReminder"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="5dp"
            android:layout_weight="1"
            android:src="@drawable/ic_alarm" />

    </LinearLayout>


</LinearLayout>